# Web Sec Lab environment. Copy to web-sec/.env only if you need to change a value;
# nothing here is loaded as shell code.
# Where history and reports are written (default: web-sec/storage, created 0700).
# WEBSEC_STORAGE=/absolute/path/to/storage
# Resolvers for the built-in DNS client (comma-separated; default: /etc/resolv.conf).
# WEBSEC_DNS_SERVERS=1.1.1.1,9.9.9.9
# Extra plugin folders, separated by ':' on macOS/Linux and ';' on Windows.
# WEBSEC_PLUGIN_DIRS=/absolute/path/to/plugins
# The scope manifest; console/scope.example.json is the template.
# OSLAB_SCOPE_FILE=/absolute/path/to/scope.json
